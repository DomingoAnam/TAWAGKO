# Copy this file to `.env` and fill in your own values, then restart the dev server.
# `.env` is git-ignored so your keys are never committed.
#
# Supabase dashboard -> Project Settings -> API
# Note: the anon key is designed to be public (it ships inside the app). Access is
# controlled by the row-level security policies in supabase/, not by hiding it.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
